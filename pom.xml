<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>com.exemplo.sorveteria</groupId>
    <artifactId>SorveteriaBackend</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>SorveteriaBackend</name>
    <description>SorveteriaBackend</description>
    <url/>
    <licenses>
        <license/>
    </licenses>
    <developers>
        <developer/>
    </developers>
    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>
    <properties>
        <java.version>21</java.version>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            No Spring Boot 4 a autoconfiguracao de MockMvc saiu do starter-test
            e passou a viver neste artefato.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            Testcontainers: sobe um PostgreSQL descartavel em Docker enquanto os
            testes rodam, e derruba no final.

            Por que isso importa: um banco em memoria (H2) nao se comporta igual
            ao PostgreSQL real. Diferencas de tipo, de constraint, de indice e de
            dialeto nao aparecem, entao o teste passa local e o sistema quebra em
            producao. Rodando contra o mesmo banco que voce usa de verdade, o teste
            vale como o teste de verdade.

            O spring-boot-testcontainers liga o container ao Spring sozinho: uma
            anotacao @ServiceConnection basta para a URL, usuario e senha serem
            configurados automaticamente.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            Atencao aos nomes: no Testcontainers 2.x os modulos ganharam o prefixo
            "testcontainers-". Antes eram org.testcontainers:postgresql e
            org.testcontainers:junit-jupiter; agora e testcontainers-postgresql e
            testcontainers-junit-jupiter. A versao vem do testcontainers-bom, que o
            Spring Boot 4.1.1 ja importa, por isso nao declaramos <version>.
        -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.persistence</groupId>
            <artifactId>jakarta.persistence-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.data</groupId>
            <artifactId>spring-data-jpa</artifactId>
        </dependency>
        <!--
            Driver do PostgreSQL. Escopo "runtime" porque nenhuma classe do nosso
            codigo importa nada do driver: o Spring so precisa dele em execucao,
            para abrir a conexao. Em compilacao ele nem entra no classpath.
        -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
            Flyway: controle de versao do schema do banco.

            Antes, o Hibernate criava e alterava as tabelas sozinho
            (ddl-auto=update). Isso funciona em estudo e e um problema em
            qualquer outro lugar: o schema existe apenas dentro do banco, nao
            fica no Git, e nao da para saber qual versao esta aplicada.

            Com Flyway, o schema passa a ser um arquivo SQL versionado em
            src/main/resources/db/migration. O Flyway le esse arquivo, compara
            com a tabela de controle que ele mesmo mantem e aplica o que falta.

            IMPORTANTE, e é uma pegadinha do Spring Boot 4: quem liga o Flyway a
            aplicacao NAO e a biblioteca do Flyway. O Spring Boot 4 foi modularizado,
            e a autoconfiguracao de cada integracao passou a viver num artefato
            proprio (spring-boot-flyway). Declarando so o flyway-core, o Flyway
            baixa, compila e... nunca roda: o banco fica vazio e o erro que aparece
            e um "missing table" na validacao do Hibernate, que nao aponta para a
            causa. Por isso usamos o starter, que ja traz a biblioteca mais a
            autoconfiguracao.

            Obs.: a partir do Flyway 10, o suporte a cada banco virou um modulo
            separado, por isso flyway-database-postgresql tambem.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        
        <dependency>
    <groupId>org.springdoc</groupId>
    <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
    <version>3.1.1</version>
</dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>21</source>
                    <target>21</target>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>1.18.46</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>